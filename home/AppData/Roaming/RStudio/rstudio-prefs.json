{
    "enable_splash_screen": false,
    "show_whats_new": false,
    "full_project_path_in_window_title": true,
    "save_workspace": "always",
    "initial_working_directory": "~",
    "show_last_dot_value": true,
    "remove_history_duplicates": true,
    "num_spaces_for_tab": 4,
    "auto_detect_indentation": true,
    "highlight_selected_line": true,
    "show_invisibles": true,
    "scroll_past_end_of_document": true,
    "smooth_scrolling": true,
    "highlight_r_function_calls": true,
    "rainbow_parentheses": true,
    "auto_append_newline": true,
    "strip_trailing_whitespace": true,
    "line_ending_conversion": "posix",
    "default_encoding": "UTF-8",
    "editor_keybindings": "emacs",
    "syntax_color_console": true,
    "font_size_points": 12,
    "editor_theme": "Tomorrow Night Bright",
    "cran_mirror": {
        "name": "Japan (Yonezawa) [https]",
        "host": "Yamagata University",
        "url": "https://ftp.yz.yamagata-u.ac.jp/pub/cran/",
        "country": "jp",
        "ok": 1,
        "secondary": ""
    },
    "show_doc_outline_rmd": true,
    "document_outline_font_size": 10,
    "doc_outline_show": "sections_and_chunks",
    "rmd_viewer_type": "pane",
    "pdf_previewer": "none",
    "windows_terminal_shell": "win-git-bash"
}